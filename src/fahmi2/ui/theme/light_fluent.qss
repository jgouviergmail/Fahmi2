/* Fahmi2 — Thème Clair Fluent (Windows 11) — baseline rehaussée
 *
 * Tokens (cf. ``ui/theme/_tokens.py`` ``LIGHT_TOKENS``) :
 *   --bg               #f5f7fb   fond fenêtre
 *   --surface          #ffffff   surface (cartes, menus, popovers)
 *   --surface-soft     #fbfcfe   surface des listes de navigation
 *   --border           #d6dae0   bordure de champ
 *   --border-card      #e9ecf1   bordure de carte
 *   --divider          #eef0f4   séparateur fin
 *   --text-1           #1f2328   texte principal
 *   --text-2           #57606a   libellé secondaire
 *   --text-3           #8b95a1   aide / micro-info
 *   --accent           #0078d4   Windows blue
 *   --accent-hover     #1086e8
 *   --accent-pressed   #006abf
 *   --accent-soft      #e3f0fb   sélection / pilule
 *   --accent-strong    #0a4f93   texte sur accent-soft
 *   --success          #1a7f37 / --success-bg #e6f6ec
 *   --warning          #b45309 / --warning-bg #fef3c7
 *   --danger           #cf222e / --danger-bg  #fcebec
 *
 * Conventions :
 *   - selectors d'objet (#objectName) pour les composants Fahmi2
 *   - selectors de classe Qt (QPushButton…) pour les éléments natifs
 *   - light_fluent.qss et dark_fluent.qss exposent **exactement** le même
 *     ensemble de sélecteurs (garde-fou : tests/unit/ui/test_theme_sync.py)
 */

/* ===== Globaux ===== */
QWidget {
    background-color: #f5f7fb;
    color: #1f2328;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow,
QDialog {
    background-color: #f5f7fb;
}

/* ===== Barre de menu ===== */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d6dae0;
    padding: 2px 6px;
}
QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #e3f0fb;
    color: #0078d4;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d6dae0;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #e3f0fb;
    color: #0078d4;
}
QMenu::separator {
    height: 1px;
    background-color: #eef0f4;
    margin: 4px 8px;
}

/* ===== Sidebar projets + listes (générique) ===== */
QListWidget {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #d6dae0;
    padding: 6px;
}
QListWidget::item {
    padding: 10px 12px;
    border-radius: 6px;
    margin-bottom: 2px;
    color: #1f2328;
}
QListWidget::item:hover {
    background-color: #eef4fb;
}
QListWidget::item:selected {
    background-color: #e3f0fb;
    color: #0a4f93;
    font-weight: 600;
}

/* ===== Header bar ===== */
#projectHeaderBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d6dae0;
}
/* Pas de bande grise derrière les QLabel de la header bar. */
#projectHeaderBar QLabel {
    background-color: transparent;
}
#projectHeaderBarTitle {
    font-size: 17px;
    font-weight: 600;
    color: #1f2328;
}

/* Boutons header */
#projectHeaderBar QPushButton {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
}
#projectHeaderBar QPushButton:hover {
    background-color: #f0f4f9;
    border-color: #b6bec8;
}
#projectHeaderBar QPushButton:pressed {
    background-color: #e3e8ee;
}
#projectHeaderBar QPushButton:disabled {
    color: #b6bec8;
    background-color: #f8f9fb;
    border-color: #d6dae0;
}

/* Variante primaire (Lancer / Reprendre) */
#projectHeaderBar QPushButton[role="primary"] {
    background-color: #0078d4;
    color: #ffffff;
    border-color: #0078d4;
    font-weight: 600;
}
#projectHeaderBar QPushButton[role="primary"]:hover {
    background-color: #1086e8;
    border-color: #1086e8;
}
#projectHeaderBar QPushButton[role="primary"]:pressed {
    background-color: #006abf;
}
#projectHeaderBar QPushButton[role="primary"]:disabled {
    background-color: #b9d5ee;
    border-color: #b9d5ee;
    color: #ffffff;
}

/* Variante danger (Annuler) */
#projectHeaderBar QPushButton[role="danger"] {
    color: #cf222e;
    border-color: #f1c8cb;
}
#projectHeaderBar QPushButton[role="danger"]:hover {
    background-color: #fcebec;
    border-color: #e9a3a8;
}
#projectHeaderBar QPushButton[role="danger"]:pressed {
    background-color: #f6d5d8;
}
#projectHeaderBar QPushButton[role="danger"]:disabled {
    color: #e9a3a8;
    border-color: #f6dde0;
    background-color: #fbf5f5;
}

/* Boutons d'action génériques (hors header) — même propriété `role` partagée,
 * pour une cohérence visuelle entre onglets. Les boutons du header gardent
 * leurs règles propres (sélecteur #projectHeaderBar, spécificité supérieure). */
QPushButton[role="default"] {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
}
QPushButton[role="default"]:hover {
    background-color: #f0f4f9;
    border-color: #b6bec8;
}
QPushButton[role="default"]:pressed {
    background-color: #e3e8ee;
}
QPushButton[role="default"]:disabled {
    color: #b6bec8;
    background-color: #f8f9fb;
    border-color: #d6dae0;
}
QPushButton[role="primary"] {
    background-color: #0078d4;
    color: #ffffff;
    border: 1px solid #0078d4;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
    font-weight: 600;
}
QPushButton[role="primary"]:hover {
    background-color: #1086e8;
    border-color: #1086e8;
}
QPushButton[role="primary"]:pressed {
    background-color: #006abf;
}
QPushButton[role="primary"]:disabled {
    background-color: #b9d5ee;
    border-color: #b9d5ee;
    color: #ffffff;
}
QPushButton[role="danger"] {
    background-color: #ffffff;
    color: #cf222e;
    border: 1px solid #f1c8cb;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
}
QPushButton[role="danger"]:hover {
    background-color: #fcebec;
    border-color: #e9a3a8;
}
QPushButton[role="danger"]:pressed {
    background-color: #f6d5d8;
}
QPushButton[role="danger"]:disabled {
    color: #e9a3a8;
    border-color: #f6dde0;
    background-color: #fbf5f5;
}

/* ===== Stats strip — cartes ===== */
#statsStrip {
    background-color: transparent;
}

#statCard {
    background-color: #ffffff;
    border: 1px solid #e9ecf1;
    border-radius: 12px;
}
/* Les QLabel placés dans une carte sont sur fond blanc :
 * on les force en transparent pour qu'aucune bande grise ne déborde. */
#statCard QLabel {
    background-color: transparent;
}

#statCardIcon {
    color: #0078d4;
    font-size: 14px;
}

#statCardTitle {
    color: #57606a;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

#statCardValue {
    color: #1f2328;
    font-size: 20px;
    font-weight: 700;
    margin-top: 2px;
}
#statCardValue[accent="running"] {
    color: #0078d4;
}
#statCardValue[accent="success"] {
    color: #1a7f37;
}
#statCardValue[accent="warning"] {
    color: #b45309;
}
#statCardValue[accent="danger"] {
    color: #cf222e;
}

#statCardSub {
    color: #8b95a1;
    font-size: 11px;
}

/* ===== Bandeau d'état pédagogie (pastille de statut) =====
 * QLabel#pedagogyStateBanner : fond doux + texte d'accent selon la propriété
 * dynamique ``state`` (cf. PedagogyState). Réutilise la palette success/warning/
 * accent des tuiles pour une présentation homogène. */
#pedagogyStateBanner {
    padding: 7px 12px;
    border-radius: 8px;
    font-weight: 600;
    background-color: #eef0f4;
    color: #57606a;
}
#pedagogyStateBanner[state="ready"] {
    background-color: #e3f0fb;
    color: #0a4f93;
}
#pedagogyStateBanner[state="up_to_date"] {
    background-color: #e6f6ec;
    color: #1a7f37;
}
#pedagogyStateBanner[state="stale"],
#pedagogyStateBanner[state="generation_required"] {
    background-color: #fef3c7;
    color: #b45309;
}

/* ===== Cost matrix (générique, partagée par les dashboards) ===== */
#costMatrix {
    background-color: #ffffff;
    border: 1px solid #e9ecf1;
    border-radius: 10px;
    gridline-color: #eef0f4;
    selection-background-color: #e3f0fb;
    selection-color: #0a4f93;
}
#costMatrix QHeaderView::section {
    background-color: #f8fafc;
    color: #57606a;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #eef0f4;
    border-bottom: 1px solid #d6dae0;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
#costMatrix QHeaderView::section:first {
    border-top-left-radius: 10px;
}
#costMatrix QHeaderView::section:last {
    border-top-right-radius: 10px;
    border-right: none;
}
#costMatrix::item {
    padding: 6px;
}

/* ===== Logs dock ===== */
QDockWidget {
    background-color: #ffffff;
    border: 1px solid #d6dae0;
}
QDockWidget::title {
    background-color: #f8fafc;
    border-bottom: 1px solid #d6dae0;
    padding: 6px 10px;
    font-weight: 600;
    color: #1f2328;
}
#logsDockContainer {
    background-color: #ffffff;
}
#logsDockContainer QLabel {
    background-color: transparent;
}
#logsDockArea {
    background-color: #fbfcfe;
    border: 1px solid #eef0f4;
    border-radius: 6px;
    font-family: "Consolas", "Cascadia Mono", "Fira Code", monospace;
    font-size: 12px;
    color: #1f2328;
    padding: 4px 6px;
}

/* ===== Onglets de fonctionnalité (QTabWidget) ===== */
QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    top: -1px;
}
QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background-color: #eef0f4;
    color: #57606a;
    border: 1px solid #d6dae0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 9px 20px;
    margin-right: 4px;
    font-weight: 600;
}
QTabBar::tab:hover {
    background-color: #e3f0fb;
    color: #0a4f93;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0078d4;
    border-color: #d6dae0;
    border-bottom: 2px solid #0078d4;
}

/* ===== Inputs, combobox, spinbox ===== */
QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    padding: 7px 11px;
    min-height: 20px;
    selection-background-color: #cfe6fa;
    selection-color: #0a4f93;
}
QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #b6bec8;
}
/* Focus : passe à une bordure 2 px avec compensation de padding pour ne pas
 * faire « sauter » la taille du contrôle (technique éprouvée). */
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid #0078d4;
    padding: 6px 10px;
}
QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #f5f7fb;
    color: #8b95a1;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}

QCheckBox {
    spacing: 8px;
    color: #1f2328;
    background-color: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b6bec8;
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #0078d4;
}
QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    /* SVG checkmark blanc embarqué en data URL pour rester sans ressource
       externe. Qt désactive le rendering natif dès qu'une règle QSS touche
       l'indicator, donc on dessine la coche nous-mêmes. */
    image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' d='M3.5 8L7 11.5L12.5 5'/></svg>");
}
QCheckBox::indicator:checked:hover {
    background-color: #1086e8;
    border-color: #1086e8;
}
QCheckBox::indicator:disabled {
    background-color: #f0f3f7;
    border-color: #d6dae0;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d6dae0;
    border-radius: 10px;
    margin-top: 16px;
    padding: 12px 12px 8px 12px;
    font-weight: 600;
    color: #1f2328;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    background-color: transparent;
    color: #0a4f93;
}
/* Les labels / cases / radios placés DANS un QGroupBox sont sur fond blanc :
 * on bloque l'héritage du fond gris global pour éviter les bandes grises. */
QGroupBox QLabel,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    background-color: transparent;
}

/* Idem dans les dialogues (NewProjectDialog, GlobalSettingsDialog) où le fond
 * principal reste --bg mais les sous-groupes blancs doivent rester nets. */
QDialog QLabel {
    background-color: transparent;
}

/* ===== Boutons génériques (dialogs) ===== */
QDialog QPushButton {
    background-color: #ffffff;
    color: #1f2328;
    border: 1px solid #d6dae0;
    border-radius: 8px;
    padding: 7px 16px;
}
QDialog QPushButton:hover {
    background-color: #f0f4f9;
    border-color: #b6bec8;
}
QDialog QPushButton:default {
    background-color: #0078d4;
    color: #ffffff;
    border-color: #0078d4;
    font-weight: 600;
}
QDialog QPushButton:default:hover {
    background-color: #1086e8;
    border-color: #1086e8;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #d6dae0;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* ===== Scrollbars (sobres) ===== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #d6dae0;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #b6bec8;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #d6dae0;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #b6bec8;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ===== Tooltips ===== */
QToolTip {
    background-color: #1f2328;
    color: #ffffff;
    border: none;
    padding: 6px 8px;
    border-radius: 4px;
}

/* ===== Liste de navigation des écrans de réglages (master-detail) ===== */
#settingsCategoryList {
    background-color: #fbfcfe;
    border: none;
    border-right: 1px solid #eef0f4;
    padding: 10px 8px;
    outline: 0;
}
#settingsCategoryList::item {
    padding: 11px 13px;
    border-radius: 9px;
    margin: 3px 2px;
    color: #57606a;
}
#settingsCategoryList::item:hover {
    background-color: #eef4fb;
    color: #1f2328;
}
#settingsCategoryList::item:selected {
    background-color: #e3f0fb;
    color: #0a4f93;
    font-weight: 600;
}

/* ===== Briques rehaussées (cards + en-têtes de page + helpers) ===== */
#card {
    background-color: #ffffff;
    border: 1px solid #e9ecf1;
    border-radius: 14px;
}
/* Tout texte/case placé DANS une carte est sur surface blanche : transparent. */
#card QLabel,
#card QCheckBox {
    background-color: transparent;
}
#cardTitle {
    font-size: 14px;
    font-weight: 700;
    color: #1f2328;
    background-color: transparent;
}
#cardDesc {
    font-size: 12px;
    color: #8b95a1;
    background-color: transparent;
}

#settingsPageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1f2328;
    background-color: transparent;
}
#settingsPageDesc {
    font-size: 13px;
    color: #8b95a1;
    background-color: transparent;
}

#fieldHint {
    font-size: 12px;
    color: #8b95a1;
    background-color: transparent;
}
#sectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: #8b95a1;
    letter-spacing: 0.6px;
    background-color: transparent;
}

/* Séparateur fin réutilisable (QFrame[objectName="hsep"]). */
#hsep {
    background-color: #eef0f4;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* ===== Éditeur de prompts ===== */
#promptsEditorStatus {
    color: #57606a;
    background-color: transparent;
}
#promptsEditorTextArea {
    background-color: #ffffff;
    border: 1px solid #d6dae0;
    border-radius: 8px;
}
