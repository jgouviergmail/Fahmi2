/* Fahmi2 — Thème Sombre Fluent — miroir token-pour-token du clair
 *
 * Tokens (cf. ``ui/theme/_tokens.py`` ``DARK_TOKENS``) :
 *   --bg               #11151c   fond fenêtre
 *   --surface          #1a1f27   surface (cartes, menus, popovers)
 *   --surface-soft     #161b22   surface des listes de navigation
 *   --surface-elevated #222831   surface des éléments « surélevés » (tooltips)
 *   --border           #2a2f38   bordure de champ
 *   --border-card      #262b34   bordure de carte
 *   --divider          #232831   séparateur fin
 *   --text-1           #e6e9ef   texte principal
 *   --text-2           #9aa3b2   libellé secondaire
 *   --text-3           #6e7787   aide / micro-info
 *   --accent           #4aa3ee   accent (remontée de luminosité)
 *   --accent-hover     #67b3f1
 *   --accent-pressed   #3a93de
 *   --accent-soft      #15314d   sélection / pilule
 *   --accent-strong    #9cc8f4   texte sur accent-soft
 *   --success          #3fb950 / --success-bg #122c1a
 *   --warning          #d29922 / --warning-bg #2c1f0f
 *   --danger           #f85149 / --danger-bg  #2c1419
 *
 * Conventions :
 *   - dark_fluent.qss et light_fluent.qss exposent **exactement** le même
 *     ensemble de sélecteurs (garde-fou : tests/unit/ui/test_theme_sync.py).
 */

/* ===== Globaux ===== */
QWidget {
    background-color: #11151c;
    color: #e6e9ef;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow,
QDialog {
    background-color: #11151c;
}

/* ===== Barre de menu ===== */
QMenuBar {
    background-color: #1a1f27;
    border-bottom: 1px solid #2a2f38;
    padding: 2px 6px;
}
QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #15314d;
    color: #4aa3ee;
}

QMenu {
    background-color: #1a1f27;
    border: 1px solid #2a2f38;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #15314d;
    color: #4aa3ee;
}
QMenu::separator {
    height: 1px;
    background-color: #232831;
    margin: 4px 8px;
}

/* ===== Sidebar projets + listes (générique) ===== */
QListWidget {
    background-color: #1a1f27;
    border: none;
    border-right: 1px solid #2a2f38;
    padding: 6px;
}
QListWidget::item {
    padding: 10px 12px;
    border-radius: 6px;
    margin-bottom: 2px;
    color: #e6e9ef;
}
QListWidget::item:hover {
    background-color: #1f2a3a;
}
QListWidget::item:selected {
    background-color: #15314d;
    color: #9cc8f4;
    font-weight: 600;
}

/* ===== Header bar ===== */
#projectHeaderBar {
    background-color: #1a1f27;
    border-bottom: 1px solid #2a2f38;
}
#projectHeaderBar QLabel {
    background-color: transparent;
}
#projectHeaderBarTitle {
    font-size: 17px;
    font-weight: 600;
    color: #e6e9ef;
}

/* Boutons header */
#projectHeaderBar QPushButton {
    background-color: #1a1f27;
    color: #e6e9ef;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
}
#projectHeaderBar QPushButton:hover {
    background-color: #232a35;
    border-color: #3d434e;
}
#projectHeaderBar QPushButton:pressed {
    background-color: #2a313e;
}
#projectHeaderBar QPushButton:disabled {
    color: #6e7787;
    background-color: #161b22;
    border-color: #2a2f38;
}

/* Variante primaire (Lancer / Reprendre) */
#projectHeaderBar QPushButton[role="primary"] {
    background-color: #4aa3ee;
    color: #0e1218;
    border-color: #4aa3ee;
    font-weight: 600;
}
#projectHeaderBar QPushButton[role="primary"]:hover {
    background-color: #67b3f1;
    border-color: #67b3f1;
}
#projectHeaderBar QPushButton[role="primary"]:pressed {
    background-color: #3a93de;
}
#projectHeaderBar QPushButton[role="primary"]:disabled {
    background-color: #2d4863;
    border-color: #2d4863;
    color: #6e7787;
}

/* Variante danger (Annuler) */
#projectHeaderBar QPushButton[role="danger"] {
    color: #f85149;
    border-color: #5e2a30;
}
#projectHeaderBar QPushButton[role="danger"]:hover {
    background-color: #2c1419;
    border-color: #b04047;
}
#projectHeaderBar QPushButton[role="danger"]:pressed {
    background-color: #4a2c30;
}
#projectHeaderBar QPushButton[role="danger"]:disabled {
    color: #6e7787;
    border-color: #41252a;
    background-color: #2a2026;
}

/* Boutons d'action génériques (hors header) */
QPushButton[role="default"] {
    background-color: #1a1f27;
    color: #e6e9ef;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
}
QPushButton[role="default"]:hover {
    background-color: #232a35;
    border-color: #3d434e;
}
QPushButton[role="default"]:pressed {
    background-color: #2a313e;
}
QPushButton[role="default"]:disabled {
    color: #6e7787;
    background-color: #161b22;
    border-color: #2a2f38;
}
QPushButton[role="primary"] {
    background-color: #4aa3ee;
    color: #0e1218;
    border: 1px solid #4aa3ee;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
    font-weight: 600;
}
QPushButton[role="primary"]:hover {
    background-color: #67b3f1;
    border-color: #67b3f1;
}
QPushButton[role="primary"]:pressed {
    background-color: #3a93de;
}
QPushButton[role="primary"]:disabled {
    background-color: #2d4863;
    border-color: #2d4863;
    color: #6e7787;
}
QPushButton[role="danger"] {
    background-color: #1a1f27;
    color: #f85149;
    border: 1px solid #5e2a30;
    border-radius: 8px;
    padding: 7px 16px;
    min-height: 22px;
}
QPushButton[role="danger"]:hover {
    background-color: #2c1419;
    border-color: #b04047;
}
QPushButton[role="danger"]:pressed {
    background-color: #4a2c30;
}
QPushButton[role="danger"]:disabled {
    color: #6e7787;
    border-color: #41252a;
    background-color: #2a2026;
}

/* ===== Stats strip — cartes ===== */
#statsStrip {
    background-color: transparent;
}

#statCard {
    background-color: #1a1f27;
    border: 1px solid #262b34;
    border-radius: 12px;
}
#statCard QLabel {
    background-color: transparent;
}

#statCardIcon {
    color: #4aa3ee;
    font-size: 14px;
}

#statCardTitle {
    color: #9aa3b2;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

#statCardValue {
    color: #e6e9ef;
    font-size: 20px;
    font-weight: 700;
    margin-top: 2px;
}
#statCardValue[accent="running"] {
    color: #4aa3ee;
}
#statCardValue[accent="success"] {
    color: #3fb950;
}
#statCardValue[accent="warning"] {
    color: #d29922;
}
#statCardValue[accent="danger"] {
    color: #f85149;
}

#statCardSub {
    color: #6e7787;
    font-size: 11px;
}

/* ===== Bandeau d'état pédagogie ===== */
#pedagogyStateBanner {
    padding: 7px 12px;
    border-radius: 8px;
    font-weight: 600;
    background-color: #232831;
    color: #9aa3b2;
}
#pedagogyStateBanner[state="ready"] {
    background-color: #15314d;
    color: #9cc8f4;
}
#pedagogyStateBanner[state="up_to_date"] {
    background-color: #122c1a;
    color: #3fb950;
}
#pedagogyStateBanner[state="stale"],
#pedagogyStateBanner[state="generation_required"] {
    background-color: #2c1f0f;
    color: #d29922;
}

/* ===== Cost matrix ===== */
#costMatrix {
    background-color: #1a1f27;
    border: 1px solid #262b34;
    border-radius: 10px;
    gridline-color: #232831;
    selection-background-color: #15314d;
    selection-color: #9cc8f4;
}
#costMatrix QHeaderView::section {
    background-color: #161b22;
    color: #9aa3b2;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #232831;
    border-bottom: 1px solid #2a2f38;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
#costMatrix QHeaderView::section:first {
    border-top-left-radius: 10px;
}
#costMatrix QHeaderView::section:last {
    border-top-right-radius: 10px;
    border-right: none;
}
#costMatrix::item {
    padding: 6px;
}

/* ===== Logs dock ===== */
QDockWidget {
    background-color: #1a1f27;
    border: 1px solid #2a2f38;
}
QDockWidget::title {
    background-color: #161b22;
    border-bottom: 1px solid #2a2f38;
    padding: 6px 10px;
    font-weight: 600;
    color: #e6e9ef;
}
#logsDockContainer {
    background-color: #1a1f27;
}
#logsDockContainer QLabel {
    background-color: transparent;
}
#logsDockArea {
    background-color: #161b22;
    border: 1px solid #232831;
    border-radius: 6px;
    font-family: "Consolas", "Cascadia Mono", "Fira Code", monospace;
    font-size: 12px;
    color: #e6e9ef;
    padding: 4px 6px;
}

/* ===== Onglets de fonctionnalité ===== */
QTabWidget::pane {
    background-color: #1a1f27;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    top: -1px;
}
QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background-color: #232831;
    color: #9aa3b2;
    border: 1px solid #2a2f38;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 9px 20px;
    margin-right: 4px;
    font-weight: 600;
}
QTabBar::tab:hover {
    background-color: #15314d;
    color: #9cc8f4;
}
QTabBar::tab:selected {
    background-color: #1a1f27;
    color: #4aa3ee;
    border-color: #2a2f38;
    border-bottom: 2px solid #4aa3ee;
}

/* ===== Inputs ===== */
QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #1a1f27;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    padding: 7px 11px;
    min-height: 20px;
    selection-background-color: #1f4571;
    selection-color: #9cc8f4;
    color: #e6e9ef;
}
QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #3d434e;
}
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid #4aa3ee;
    padding: 6px 10px;
}
QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #161b22;
    color: #6e7787;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}

QCheckBox {
    spacing: 8px;
    color: #e6e9ef;
    background-color: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3d434e;
    border-radius: 4px;
    background-color: #1a1f27;
}
QCheckBox::indicator:hover {
    border-color: #4aa3ee;
}
QCheckBox::indicator:checked {
    background-color: #4aa3ee;
    border-color: #4aa3ee;
    image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path fill='none' stroke='%230e1218' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' d='M3.5 8L7 11.5L12.5 5'/></svg>");
}
QCheckBox::indicator:checked:hover {
    background-color: #67b3f1;
    border-color: #67b3f1;
}
QCheckBox::indicator:disabled {
    background-color: #161b22;
    border-color: #2a2f38;
}

QGroupBox {
    background-color: #1a1f27;
    border: 1px solid #2a2f38;
    border-radius: 10px;
    margin-top: 16px;
    padding: 12px 12px 8px 12px;
    font-weight: 600;
    color: #e6e9ef;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    background-color: transparent;
    color: #9cc8f4;
}
QGroupBox QLabel,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    background-color: transparent;
}

QDialog QLabel {
    background-color: transparent;
}

/* ===== Boutons génériques (dialogs) ===== */
QDialog QPushButton {
    background-color: #1a1f27;
    color: #e6e9ef;
    border: 1px solid #2a2f38;
    border-radius: 8px;
    padding: 7px 16px;
}
QDialog QPushButton:hover {
    background-color: #232a35;
    border-color: #3d434e;
}
QDialog QPushButton:default {
    background-color: #4aa3ee;
    color: #0e1218;
    border-color: #4aa3ee;
    font-weight: 600;
}
QDialog QPushButton:default:hover {
    background-color: #67b3f1;
    border-color: #67b3f1;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #2a2f38;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #2a2f38;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #3d434e;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #2a2f38;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #3d434e;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ===== Tooltips ===== */
QToolTip {
    background-color: #222831;
    color: #e6e9ef;
    border: 1px solid #2a2f38;
    padding: 6px 8px;
    border-radius: 4px;
}

/* ===== Liste de navigation des écrans de réglages ===== */
#settingsCategoryList {
    background-color: #161b22;
    border: none;
    border-right: 1px solid #232831;
    padding: 10px 8px;
    outline: 0;
}
#settingsCategoryList::item {
    padding: 11px 13px;
    border-radius: 9px;
    margin: 3px 2px;
    color: #9aa3b2;
}
#settingsCategoryList::item:hover {
    background-color: #1f2a3a;
    color: #e6e9ef;
}
#settingsCategoryList::item:selected {
    background-color: #15314d;
    color: #9cc8f4;
    font-weight: 600;
}

/* ===== Briques rehaussées (cards + en-têtes de page + helpers) ===== */
#card {
    background-color: #1a1f27;
    border: 1px solid #262b34;
    border-radius: 14px;
}
#card QLabel,
#card QCheckBox {
    background-color: transparent;
}
#cardTitle {
    font-size: 14px;
    font-weight: 700;
    color: #e6e9ef;
    background-color: transparent;
}
#cardDesc {
    font-size: 12px;
    color: #6e7787;
    background-color: transparent;
}

#settingsPageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #e6e9ef;
    background-color: transparent;
}
#settingsPageDesc {
    font-size: 13px;
    color: #6e7787;
    background-color: transparent;
}

#fieldHint {
    font-size: 12px;
    color: #6e7787;
    background-color: transparent;
}
#sectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: #6e7787;
    letter-spacing: 0.6px;
    background-color: transparent;
}

#hsep {
    background-color: #232831;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* ===== Footer de dialogue ===== */
#dialogFooter {
    background-color: #1a1f27;
    border-top: 1px solid #232831;
}
#dialogFooter QPushButton {
    min-width: 96px;
}

/* ===== Source order — liste compacte ===== */
#sourceOrderList {
    background-color: #1a1f27;
    border: 1px solid #262b34;
    border-radius: 8px;
}
#sourceOrderList::item {
    padding: 6px 10px;
    margin-bottom: 1px;
    border-radius: 4px;
    color: #e6e9ef;
}
#sourceOrderList::item:hover {
    background-color: #232a35;
}
#sourceOrderList::item:selected {
    background-color: #15314d;
    color: #9cc8f4;
}

/* ===== Sidebar projets — rendu deux lignes (pastille + nom + sous-libellé) ===== */
#projectsSidebar {
    padding: 8px 6px;
}
#projectsSidebar::item {
    padding: 0;
    margin: 2px 4px;
    border-radius: 8px;
    background-color: transparent;
}
#projectsSidebar::item:hover {
    background-color: #1f2a3a;
}
#projectsSidebar::item:selected {
    background-color: #15314d;
}
#projectListDot {
    font-size: 16px;
    color: #3d434e;
    background-color: transparent;
}
#projectListDot[accent="success"] {
    color: #3fb950;
}
#projectListDot[accent="running"] {
    color: #4aa3ee;
}
#projectListDot[accent="warning"] {
    color: #d29922;
}
#projectListDot[accent="danger"] {
    color: #f85149;
}
#projectListDot[accent="neutral"] {
    color: #3d434e;
}
#projectListName {
    font-size: 13px;
    font-weight: 600;
    color: #e6e9ef;
    background-color: transparent;
}
#projectListSubtitle {
    font-size: 11px;
    color: #6e7787;
    background-color: transparent;
}

/* ===== Éditeur de prompts ===== */
#promptsEditorStatus {
    color: #9aa3b2;
    background-color: transparent;
}
#promptsEditorTextArea {
    background-color: #1a1f27;
    border: 1px solid #2a2f38;
    border-radius: 8px;
}
